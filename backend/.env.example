ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://bursatrack:bursatrack@localhost:5433/bursatrack

# Comma-separated allowlist (architecture §14.3). docker-compose's frontend
# service is reachable from the host browser at localhost:3000, so this is
# the same origin whether the backend runs natively or in the compose stack.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RS256 keypair for JWT signing (architecture §14.1). Generate locally with:
#   openssl genrsa -out /tmp/jwt_private.pem 2048
#   openssl rsa -in /tmp/jwt_private.pem -pubout -out /tmp/jwt_public.pem
# Paste the PEM contents below with real newlines inside the quotes (python-dotenv
# supports multi-line quoted values). Never commit real keys.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_EXPIRY_DAYS=7

TRIAL_PERIOD_DAYS=14
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

SESSION_COOKIE_NAME=bursatrack_session
COOKIE_SECURE=true

ADMIN_API_KEY=change-me

# Resend (architecture §11.3) — get a key from https://resend.com after signing
# up (free tier: 3,000 emails/month). Not related to Render; works from any host.
RESEND_API_KEY=re_your_api_key_here
# Resend's sandbox sender below works with no domain verification — fine for
# local dev. Swap to a verified BursaTrack domain address before launch.
EMAIL_FROM_ADDRESS="BursaTrack <onboarding@resend.dev>"
# Where emailed verify/reset links point.
FRONTEND_BASE_URL=http://localhost:3000

# --- Not yet consumed by any app code — reserved per architecture §14.5 ---
# SENTRY_DSN: wired up in DEP-9.5. app/monitoring.py is a structlog-only stand-in
# until then; setting this today has no effect.
# SENTRY_DSN=
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET: wired up in Epic 7 (subscription
# module doesn't exist yet). Use Stripe *test-mode* keys in every
# non-production environment (MED-R-001).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
